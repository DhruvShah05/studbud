{
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "lint": "./lint-all.sh",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && source venv/bin/activate && flake8 --max-line-length=100 --exclude=venv,__pycache__ .",
    "format:backend": "cd backend && source venv/bin/activate && black ."
  }
}
